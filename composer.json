{
    "name": "btcpayserver/whmcs",
    "description": "BTCPay Server payment plugin for WHMCS",
    "type": "whmcs-plugin",
    "keywords": ["whmcs","plugin","payment","ecommerce","bitcoin","btcpay","btcpayserver"],
    "homepage": "https://github.com/btcpayserver/whmcs-plugin",
    "license": "MIT",
    "support": {
        "email": "support@btcpayserver.org",
        "issues": "https://github.com/btcpayserver/whmcs-plugin/issues",
        "source": "https://github.com/btcpayserver/whmcs-plugin"
    },
    "minimum-stability": "stable",
    "authors": [
        {
            "name": "BTCPay Server Integrations Development Team"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-bcmath": "*",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "btcpayserver/btcpayserver-greenfield-php": "^2.9.1"
    },
    "require-dev": {
        "illuminate/database": "^10.49",
        "illuminate/events": "^10.49"
    },
    "scripts": {
        "test": [
            "@php tests/bp_invoice_contract_test.php",
            "@php tests/btcpay_security_test.php",
            "@php tests/greenfield_test.php",
            "@php tests/webhook_setup_test.php",
            "@php tests/webhook_reregister_test.php",
            "@php tests/manage_page_test.php",
            "@php tests/settings_save_test.php"
        ],
        "test-integration": "@php tests/integration_test.php"
    },
    "config": {
        "vendor-dir": "modules/gateways/btcpay/vendor",
        "platform": {"php": "8.1.0"},
        "sort-packages": true,
        "allow-plugins": false
    }
}
